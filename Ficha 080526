    </div>
  </div>

  <div class="bottom-nav">
    <div class="bottom-nav-inner">
      <button class="btn-nav btn-prev" onclick="goTo(3)">← Voltar</button>
      <div class="step-dots" id="dots4"></div>
      <button class="btn-nav btn-finish" onclick="goTo(5)">Gerar Resumo ✓</button>
    </div>
  </div>
</div>

<!-- ══════════════════════════════════
     SEÇÃO 6 — RESUMO
══════════════════════════════════ -->
<div class="section" id="sec-5">
  <div class="card">
    <div class="card-header">
      <div class="card-icon blue">📄</div>
      <div class="card-title">Resumo da Ficha</div>
    </div>
    <div class="card-body" id="summaryContent"></div>
  </div>

  <div style="display:flex;gap:10px;margin-bottom:12px">
    <button class="btn-nav btn-prev" style="flex:1;height:44px" onclick="goTo(0)">← Editar</button>
    <button class="btn-nav btn-finish" style="flex:1;height:44px" onclick="showPDFModal()">⬇ Salvar PDF</button>
  </div>

  <div class="bottom-nav">
    <div class="bottom-nav-inner">
      <button class="btn-nav btn-prev" onclick="goTo(4)">← Voltar</button>
      <div class="step-dots" id="dots5"></div>
      <div style="flex:1"></div>
    </div>
  </div>
</div>

</div><!-- /main -->

<!-- ══ PDF MODAL ══ -->
<div class="modal-bg" id="pdfModal">
  <div class="modal">
    <h2>📄 Salvar como PDF</h2>
    <p>No iPhone, siga esses passos:</p>
    <div class="modal-step">
      <div class="modal-step-num">1</div>
      <div class="modal-step-txt">Toque no ícone <strong>Compartilhar ↑</strong> na barra inferior do Safari</div>
    </div>
    <div class="modal-step">
      <div class="modal-step-num">2</div>
      <div class="modal-step-txt">Role e toque em <strong>"Imprimir"</strong></div>
    </div>
    <div class="modal-step">
      <div class="modal-step-num">3</div>
      <div class="modal-step-txt">Na prévia, faça um gesto de <strong>pinça para ampliar</strong> — converte em PDF automaticamente</div>
    </div>
    <div class="modal-step">
      <div class="modal-step-num">4</div>
      <div class="modal-step-txt">Toque em <strong>Compartilhar</strong> → salve em Arquivos, envie por WhatsApp ou e-mail</div>
    </div>
    <button class="modal-close" onclick="closePDF()">Entendido</button>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
// ── GLOBALS ──
let curStep = 0;
let monCols = 5;
const TOTAL_STEPS = 6;
const MON_ROWS = ['FC (bpm)','FR (mpm)','SpO₂ (%)','ET Isof/Sevo (%)','Temp. (°C)','PAM (mmHg)','PAS (mmHg)','PETCO₂ (mmHg)','Profundidade'];

// ── NAVIGATION ──
function goTo(s) {
  document.querySelectorAll('.section').forEach((el,i) => el.classList.toggle('active', i===s));
  document.querySelectorAll('.tab').forEach((el,i) => {
    el.classList.remove('active','done');
    if(i===s) el.classList.add('active');
    else if(i<s) el.classList.add('done');
  });
  curStep = s;
  renderDots();
  window.scrollTo({top:0,behavior:'smooth'});
  if(s===5) buildSummary();
  if(s===2) calcAll();
}

function renderDots() {
  ['dots','dots1','dots2','dots3','dots4','dots5'].forEach(id => {
    const el = document.getElementById(id);
    if(!el) return;
    el.innerHTML = Array.from({length:TOTAL_STEPS}, (_,i) => {
      let cls = 'dot';
      if(i===curStep) cls+=' active';
      else if(i<curStep) cls+=' done';
      return `<div class="${cls}" onclick="goTo(${i})"></div>`;
    }).join('');
  });
}

// ── LOGO ──
function loadLogo(input) {
  const file = input.files[0];
  if(!file) return;
  const reader = new FileReader();
  reader.onload = e => {
    const img = document.getElementById('logoImg');
    img.src = e.target.result;
    img.style.display = 'block';
    document.querySelector('.logo-placeholder').style.display = 'none';
  };
  reader.readAsDataURL(file);
}

// ── ASA ──
function selASA(btn) {
  document.querySelectorAll('.asa-btn').forEach(b => b.classList.remove('sel'));
  btn.classList.add('sel');
  document.getElementById('asa').value = btn.dataset.val;
}

// ── DOSE CALCULATOR (corrigido) ──
// Doses fixas de referência
const FIXED_DOSES = [
  { name:'Morfina IV', desc:'0,3 mg/kg · sol. 10 mg/mL', calc: p => (p*0.3)/10, unit:'mL' },
  { name:'Metadona IV', desc:'0,3 mg/kg · sol. 10 mg/mL', calc: p => (p*0.3)/10, unit:'mL' },
  { name:'Medetomidina', desc:'20 µg/kg · sol. 1 mg/mL', calc: p => (p*0.02)/1, unit:'mL' },
  { name:'Dexmedetomidina', desc:'5 µg/kg · sol. 0,5 mg/mL', calc: p => (p*0.005)/0.5, unit:'mL' },
  { name:'Propofol IV', desc:'4 mg/kg · sol. 10 mg/mL', calc: p => (p*4)/10, unit:'mL' },
  { name:'Cetamina', desc:'5 mg/kg · sol. 100 mg/mL', calc: p => (p*5)/100, unit:'mL' },
  { name:'Fentanil IV', desc:'5 µg/kg · sol. 50 µg/mL', calc: p => (p*0.005)/0.05, unit:'mL' },
  { name:'Midazolam', desc:'0,3 mg/kg · sol. 5 mg/mL', calc: p => (p*0.3)/5, unit:'mL' },
  { name:'Diazepam', desc:'0,3 mg/kg · sol. 5 mg/mL', calc: p => (p*0.3)/5, unit:'mL' },
  { name:'Atropina', desc:'0,044 mg/kg · sol. 0,25 mg/mL', calc: p => (p*0.044)/0.25, unit:'mL' },
  { name:'Fluido manutenção', desc:'10 mL/kg/h', calc: p => p*10, unit:'mL/h' },
];

function calcAll() {
  const p = parseFloat(document.getElementById('peso').value)||0;
  document.getElementById('pesoDisplay').textContent = p||'—';

  const wrap = document.getElementById('calcDoses');
  wrap.innerHTML = FIXED_DOSES.map(d => {
    const v = p ? d.calc(p).toFixed(2)+' '+d.unit : '—';
    return `<div class="dose-row">
      <div class="dose-info">
        <div class="dose-name">${d.name}</div>
        <div class="dose-desc">${d.desc}</div>
      </div>
      <div class="dose-val">${v}</div>
    </div>`;
  }).join('');

  // Recalcular doses personalizadas
  recalcCustomDoses(p);
  // Recalcular CRIs
  recalcCRIs(p);
}

// ── DOSE PERSONALIZADA (com correção mg/mcg) ──
function addCustomDose() {
  const list = document.getElementById('customDoseList');
  const id = Date.now();
  const div = document.createElement('div');
  div.className = 'custom-dose-wrap';
  div.id = 'cd-'+id;
  div.innerHTML = `
    <div class="custom-dose-grid">
      <div>
        <div class="cri-label">Fármaco</div>
        <input type="text" placeholder="Nome do fármaco" oninput="recalcCD('${id}')">
      </div>
      <div>
        <div class="cri-label">Dose</div>
        <input type="number" step="any" placeholder="0" inputmode="decimal" oninput="recalcCD('${id}')">
      </div>
      <div>
        <div class="cri-label">Unidade</div>
        <select onchange="recalcCD('${id}')">
          <option value="mg_kg">mg/kg</option>
          <option value="mcg_kg">µg/kg</option>
          <option value="mg_kg_h">mg/kg/h</option>
          <option value="mcg_kg_h">µg/kg/h</option>
          <option value="mg_kg_min">mg/kg/min</option>
          <option value="mcg_kg_min">µg/kg/min</option>
        </select>
      </div>
      <div>
        <div class="cri-label">Conc. sol. (mg/mL)</div>
        <input type="number" step="any" placeholder="10" inputmode="decimal" oninput="recalcCD('${id}')">
      </div>
      <div>
        <div class="cri-label">Resultado</div>
        <div class="custom-dose-result" id="cd-result-${id}">—</div>
      </div>
    </div>
    <div style="margin-top:6px;display:flex;justify-content:flex-end">
      <button class="btn-rm" onclick="document.getElementById('cd-${id}').remove()" style="width:auto;padding:0 12px;font-size:13px">Remover</button>
    </div>`;
  list.appendChild(div);
}

function recalcCD(id) {
  const el = document.getElementById('cd-'+id);
  if(!el) return;
  const inputs = el.querySelectorAll('input[type=number]');
  const unitSel = el.querySelector('select');
  const dose = parseFloat(inputs[0].value)||0;
  const conc = parseFloat(inputs[1].value)||0;
  const unit = unitSel.value;
  const p = parseFloat(document.getElementById('peso').value)||0;
  const result = document.getElementById('cd-result-'+id);
  if(!dose||!conc||!p){ result.textContent='—'; return; }

  // Converter para mg se a unidade for µg (1 µg = 0,001 mg)
  const isMcg = unit.startsWith('mcg');
  const doseInMg = isMcg ? dose * 0.001 : dose;

  const isPerH = unit.endsWith('_h');
  const isPerMin = unit.endsWith('_min');

  const totalMg = doseInMg * p; // mg total (ou mg/h ou mg/min)
  const vol = totalMg / conc;  // mL

  if(isPerH) result.textContent = vol.toFixed(3)+' mL/h';
  else if(isPerMin) result.textContent = vol.toFixed(3)+' mL/min';
  else result.textContent = vol.toFixed(3)+' mL';
}

function recalcCustomDoses(p) {
  document.querySelectorAll('[id^="cd-"]:not([id^="cd-result"])').forEach(el => {
    const id = el.id.replace('cd-','');
    if(id && !isNaN(id)) recalcCD(id);
  });
}

// ── CRI / INFUSÕES CONTÍNUAS ──
function addCRI() {
  const list = document.getElementById('cri-list');
  const id = Date.now();
  const div = document.createElement('div');
  div.className = 'cri-row';
  div.id = 'cri-'+id;
  div.innerHTML = `
    <div class="cri-row-top">
      <div>
        <div class="cri-label">Fármaco</div>
        <input type="text" placeholder="Ex: Fentanil, Lidocaína..." oninput="recalcCRI('${id}')">
      </div>
      <div>
        <div class="cri-label">Dose alvo</div>
        <input type="number" step="any" placeholder="0" inputmode="decimal" oninput="recalcCRI('${id}')">
      </div>
      <div>
        <div class="cri-label">Unidade</div>
        <select onchange="recalcCRI('${id}')">
          <option value="mcg_kg_min">µg/kg/min</option>
          <option value="mcg_kg_h">µg/kg/h</option>
          <option value="mg_kg_h">mg/kg/h</option>
          <option value="mg_kg_min">mg/kg/min</option>
        </select>
      </div>
    </div>
    <div class="cri-row-mid">
      <div>
        <div class="cri-label">Conc. sol. (mg/mL)</div>
        <input type="number" step="any" placeholder="Ex: 0,05" inputmode="decimal" oninput="recalcCRI('${id}')">
      </div>
      <div>
        <div class="cri-label">Vol seringa (mL)</div>
        <input type="number" placeholder="50" inputmode="decimal" oninput="recalcCRI('${id}')">
      </div>
      <div>
        <div class="cri-label">Horário início</div>
        <input type="time">
      </div>
    </div>
    <div class="cri-row-bot">
      <div>
        <div class="cri-label">Taxa calculada</div>
        <div class="cri-result" id="cri-result-${id}">—</div>
      </div>
      <button class="btn-rm-cri" onclick="document.getElementById('cri-${id}').remove()">×</button>
    </div>
    <div style="margin-top:8px">
      <div class="cri-label">Anotações / ajustes de taxa</div>
      <textarea style="width:100%;font-family:var(--font);font-size:13px;background:var(--white);border:1.5px solid var(--blue-mid);border-radius:6px;padding:8px 10px;min-height:56px;resize:vertical;color:var(--slate)" placeholder="Ex: 09h32 — aumentado para 10 µg/kg/h; 10h15 — reduzido..."></textarea>
    </div>`;
  list.appendChild(div);
}

function recalcCRI(id) {
  const el = document.getElementById('cri-'+id);
  if(!el) return;
  const inputs = el.querySelectorAll('input[type=number]');
  const unitSel = el.querySelector('select');
  const dose = parseFloat(inputs[0].value)||0;
  const conc = parseFloat(inputs[1].value)||0;
  const unit = unitSel.value;
  const p = parseFloat(document.getElementById('peso').value)||0;
  const result = document.getElementById('cri-result-'+id);
  if(!dose||!conc||!p){ result.textContent='—'; return; }

  // Converter µg para mg
  const isMcg = unit.startsWith('mcg');
  const doseInMg = isMcg ? dose * 0.001 : dose;

  const isPerMin = unit.endsWith('_min');

  // mg/kg/h ou mg/kg/min × peso = mg/h ou mg/min
  let mgPerUnit = doseInMg * p;
  // converter para mL/h
  let mlPerH = isPerMin ? (mgPerUnit * 60) / conc : mgPerUnit / conc;

  result.textContent = mlPerH.toFixed(2)+' mL/h';
}

function recalcCRIs(p) {
  document.querySelectorAll('[id^="cri-"]:not([id^="cri-result"])').forEach(el => {
    const id = el.id.replace('cri-','');
    if(id && !isNaN(id)) recalcCRI(id);
  });
}

// ── DRUG ROWS ──
function addDrug(listId) {
  const list = document.getElementById(listId+'-list');
  const row = document.createElement('div');
  row.className = 'drug-row';
  row.innerHTML = `
    <input type="text" placeholder="Fármaco">
    <input type="text" placeholder="—" inputmode="decimal">
    <input type="text" placeholder="—" inputmode="decimal">
    <select><option value="">Via</option>
      <option>IV</option><option>IM</option><option>SC</option>
      <option>EV cont.</option><option>Epidural</option><option>Inalatória</option>
    </select>
    <button class="btn-rm" onclick="this.parentElement.remove()">×</button>`;
  list.appendChild(row);
}

// ── MONITORING TABLE ──
function buildMonTable() {
  const t = document.getElementById('mon-table');
  let html = '<thead><tr><th>Parâmetro</th>';
  for(let c=0;c<monCols;c++) html += `<th><input type="time" style="background:transparent;border:none;color:inherit;width:100%;text-align:center;font-family:var(--mono);font-size:11px;font-weight:600;padding:4px 0;min-height:auto;"></th>`;
  html += '</tr></thead><tbody>';
  MON_ROWS.forEach(r => {
    html += `<tr><td class="lbl">${r}</td>`;
    for(let c=0;c<monCols;c++) html += `<td><input type="text" inputmode="decimal"></td>`;
    html += '</tr>';
  });
  html += '</tbody>';
  t.innerHTML = html;
}
function addMonCol() { monCols++; buildMonTable(); }

// ── SUMMARY ──
function v(id) { const el=document.getElementById(id); return el?(el.value.trim()||'—'):'—'; }

function buildSummary() {
  const R = (l,val) => `<div class="sum-row"><span class="sum-label">${l}</span><span class="sum-val">${val}</span></div>`;
  const S = (title, rows) => `<div class="sum-section"><div class="sum-title">${title}</div>${rows}</div>`;
  document.getElementById('summaryContent').innerHTML =
    S('Identificação',
      R('Paciente', v('nome')) +
      R('Espécie / Raça', v('especie')+' / '+v('raca')) +
      R('Peso', v('peso')+' kg') + R('Sexo', v('sexo')) +
      R('Procedimento', v('procedimento')) + R('Data', v('data')) +
      R('Local', v('local')) + R('Anestesista', v('anestesista')) +
      R('Cirurgião', v('cirurgiao')) + R('Auxiliar', v('auxiliar'))) +
    S('Avaliação Pré',
      R('ASA', v('asa')) + R('FC basal', v('fc_basal')+' bpm') +
      R('Temp. basal', v('temp_basal')+' °C') + R('SpO₂ basal', v('spo2_basal')+' %') +
      R('Mucosas', v('mucosas')) + R('Hidratação', v('hidratacao')) +
      R('Jejum sólido', v('jej_sol')+' h') + R('Jejum hídrico', v('jej_hid')+' h')) +
    S('Protocolo',
      R('Indução', v('tec_ind')) + R('Hora indução', v('hora_ind')) +
      R('Tubo ET', v('tubo')+' mm') + R('Manutenção', v('manut_ag')) +
      R('Circuito', v('circuito')) + R('Ventilação', v('ventilacao')) +
      R('Fluido', v('fluido_sol')+' — '+v('fluido_taxa')+' mL/kg/h')) +
    S('Intraoperatório',
      R('Início anestesia', v('hora_inicio')) + R('Início cirurgia', v('hora_cx')) +
      R('Término cirurgia', v('hora_cx_fim')) + R('Término anestesia', v('hora_fim')) +
      R('Intercorrências', v('intercorrencias'))) +
    S('Recuperação',
      R('Extubação', v('hora_extub')) + R('Temp. recup.', v('temp_rec')+' °C') +
      R('Qualidade', v('qual_rec')) + R('Escala dor', v('escala_dor')) +
      R('Escore T0', v('escore_t0')) + R('Observações', v('observacoes')));
}

// ── PDF MODAL ──
function showPDFModal() { buildSummary(); document.getElementById('pdfModal').classList.add('show'); }
function closePDF() { document.getElementById('pdfModal').classList.remove('show'); }
document.getElementById('pdfModal').addEventListener('click', function(e){ if(e.target===this) closePDF(); });

// ── TOAST ──
function toast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg; t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'),2500);
}

// ── INIT ──
function init() {
  buildMonTable();
  calcAll();
  renderDots();
  addDrug('mpa'); addDrug('ind'); addDrug('manut'); addDrug('posop');
  document.getElementById('data').value = new Date().toISOString().split('T')[0];
}

init();
</script>
</body>
